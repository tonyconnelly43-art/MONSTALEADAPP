# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real keys.

# Milestone 2 — live discovery (server-only). Restrict the key to "Places API (New)".
GOOGLE_PLACES_API_KEY=

# Hard ceiling on billable Places requests per UTC day (cost guard).
PLACES_DAILY_REQUEST_CAP=20

# Milestone 4 — optional, free. Improves PageSpeed Insights quota.
PAGESPEED_API_KEY=

# Optional. Only needed for Claude-written audits/drafts (template drafts are free).
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5; claude-haiku-5-5 is far cheaper).
ANTHROPIC_MODEL=

# Signature used in outreach drafts. Unset values appear as [Your …] placeholders.
# A physical mailing address and an opt-out line are required in commercial email (CAN-SPAM).
SENDER_NAME=
SENDER_COMPANY=Monsta Media & Design
SENDER_EMAIL=
SENDER_PHONE=
SENDER_ADDRESS=
SENDER_REGION=Northeast Ohio

# Shared team password. REQUIRED on Vercel — without it the deployment stays locked.
# Not needed for local development (the app is open locally when unset).
APP_PASSWORD=

# Optional: random string (e.g. `openssl rand -base64 32`) used to sign session cookies.
# If unset, sessions are signed with a key derived from APP_PASSWORD.
SESSION_SECRET=

# Postgres (e.g. Neon via Vercel Marketplace — use the POOLED connection string).
# When unset, prospects are saved in each user's browser only.
DATABASE_URL=

# Days to keep Google-supplied business details before clearing them (place IDs, your
# statuses and notes are always kept). Confirm against Google Maps Platform terms.
GOOGLE_CONTENT_RETENTION_DAYS=30
